# ──────────────────────────────────────────────────────────────
# Example variable values — copy to terraform.tfvars and edit
# ──────────────────────────────────────────────────────────────

aws_region   = "us-west-2"
project_name = "multi-agent-pipeline"
environment  = "dev"

# Container image tag (overridden by CI/CD, defaults to "latest")
# ecr_image_tag = "latest"

# Bedrock model for the orchestrator
# agentcore_model_id = "anthropic.claude-sonnet-5"

# Memory event expiry (days)
# memory_event_expiry_days = 90

# ARN of an existing Secrets Manager secret for GitHub PAT
# (used by submit_pr tool). Leave empty if not using submit_pr.
# github_token_secret_arn = "arn:aws:secretsmanager:us-west-2:123456789012:secret:github-pat-AbCdEf"

# S3 bucket for browser session recordings (leave empty to disable)
# browser_recording_s3_bucket = "my-browser-recordings-bucket"

# CloudWatch log retention (days)
# log_retention_days = 30
